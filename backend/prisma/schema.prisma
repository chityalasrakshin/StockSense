datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum Role {
  INVENTORY_MANAGER
  WAREHOUSE_STAFF
}

enum DocumentType {
  RECEIPT
  DELIVERY
  TRANSFER
  ADJUSTMENT
}

enum DocumentStatus {
  DRAFT
  WAITING
  READY
  DONE
  CANCELED
}

enum LocationType {
  WAREHOUSE
  ZONE
  RACK
  BIN
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(WAREHOUSE_STAFF)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  otpCodes        OtpCode[]
  refreshTokens   RefreshToken[]
  createdDocs     Document[]    @relation("DocumentCreatedBy")
  responsibleDocs Document[]    @relation("DocumentResponsibleUser")
  validatedDocs   Document[]    @relation("DocumentValidatedBy")
  ledgerEntries   StockLedger[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  family    String
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, family])
  @@map("refresh_tokens")
}

model OtpCode {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  codeHash   String    @map("code_hash")
  purpose    String
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otp_codes")
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  parentId  String?    @map("parent_id")
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  products  Product[]

  @@map("categories")
}

model UnitOfMeasure {
  id       String    @id @default(uuid())
  code     String    @unique
  name     String
  products Product[]

  @@map("units_of_measure")
}

model Product {
  id           String         @id @default(uuid())
  sku          String         @unique
  name         String
  unitCost     Decimal        @default(0.0) @map("unit_cost") @db.Decimal(12, 2)
  categoryId   String?        @map("category_id")
  uomId        String?        @map("uom_id")
  reorderPoint Int            @default(10) @map("reorder_point")
  reorderQty   Int            @default(50) @map("reorder_qty")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  category   Category?      @relation(fields: [categoryId], references: [id])
  uom        UnitOfMeasure? @relation(fields: [uomId], references: [id])
  docLines   DocumentLine[]
  ledgerRows StockLedger[]
  balances   StockBalance[]

  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("products")
}

model Location {
  id        String       @id @default(uuid())
  name      String
  shortCode String       @unique @map("short_code")
  type      LocationType @default(WAREHOUSE)
  parentId  String?      @map("parent_id")
  parent    Location?    @relation("LocationHierarchy", fields: [parentId], references: [id])
  children  Location[]   @relation("LocationHierarchy")

  sourceDocs Document[]     @relation("DocumentSourceLocation")
  destDocs   Document[]     @relation("DocumentDestLocation")
  ledgerRows StockLedger[]
  balances   StockBalance[]

  @@map("locations")
}

/// Document: The core stateful workflow engine record (Receipts, Deliveries, Transfers, Adjustments).
///
/// Reference Formatting & Prefix Mapping:
/// Format: <warehouse.short_code>/<IN or OUT>/<zero-padded incrementing sequence> (e.g. WH/IN/00001, WH/OUT/00001)
/// Server-side generated upon creation:
/// - RECEIPT: Incoming goods into destination warehouse -> IN
/// - DELIVERY: Outgoing customer dispatch from source warehouse -> OUT
/// - TRANSFER: Movement dispatched from source warehouse -> OUT
/// - ADJUSTMENT: Inventory reconciliation: decrease (loss/damage/scrap) -> OUT; increase (found) -> IN
///
/// NOTE on "Free to Use" Stock Design:
/// "Free to Use" (available stock) = stock_balances.quantity minus the sum of document_lines.expected_qty
/// for all outgoing documents (DELIVERY, or TRANSFER where source is this location) currently in
/// 'READY' or 'WAITING' status. This will be implemented as a dynamic aggregation query in Prompt 5/6,
/// NOT as a stored column, so reserved_qty is intentionally omitted from the schema.
model Document {
  id                String         @id @default(uuid())
  reference         String         @unique
  type              DocumentType
  status            DocumentStatus @default(DRAFT)
  sourceLocationId  String?        @map("source_location_id")
  destLocationId    String?        @map("dest_location_id")
  contact           String?
  partnerRef        String?        @map("partner_ref")
  scheduleDate      DateTime?      @map("schedule_date")
  createdById       String         @map("created_by")
  responsibleUserId String         @map("responsible_user_id")
  validatedById     String?        @map("validated_by")
  validatedAt       DateTime?      @map("validated_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  sourceLocation  Location?      @relation("DocumentSourceLocation", fields: [sourceLocationId], references: [id])
  destLocation    Location?      @relation("DocumentDestLocation", fields: [destLocationId], references: [id])
  createdBy       User           @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  responsibleUser User           @relation("DocumentResponsibleUser", fields: [responsibleUserId], references: [id])
  validatedBy     User?          @relation("DocumentValidatedBy", fields: [validatedById], references: [id])
  lines           DocumentLine[]
  ledgerEntries   StockLedger[]

  @@index([status, type, createdAt])
  @@map("documents")
}

model DocumentLine {
  id          String   @id @default(uuid())
  documentId  String   @map("document_id")
  productId   String   @map("product_id")
  expectedQty Int      @map("expected_qty")
  actualQty   Int?     @map("actual_qty")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("document_lines")
}

/// StockLedger: Immutable, append-only source of truth for all inventory movements.
/// INVARIANT: Never perform UPDATE or DELETE on this table anywhere in the codebase.
/// Every physical stock movement (receipt, delivery, transfer, adjustment) inserts here.
model StockLedger {
  id           String   @id @default(uuid())
  productId    String   @map("product_id")
  locationId   String   @map("location_id")
  documentId   String?  @map("document_id")
  qtyDelta     Int      @map("qty_delta")
  balanceAfter Int      @map("balance_after")
  postedAt     DateTime @default(now()) @map("posted_at")
  actorId      String   @map("actor_id")

  product  Product   @relation(fields: [productId], references: [id])
  location Location  @relation(fields: [locationId], references: [id])
  document Document? @relation(fields: [documentId], references: [id])
  actor    User      @relation(fields: [actorId], references: [id])

  @@index([productId, locationId, postedAt])
  @@map("stock_ledger")
}

/// StockBalance: Derived read-model cache of stock_ledger for O(1) balance and KPI reads.
/// INVARIANT: Kept in atomic sync with stock_ledger writes inside the document validation transaction.
/// Locked with SELECT ... FOR UPDATE during validation to eliminate race conditions.
/// DB CHECK constraint enforces quantity >= 0 (no backorders at this stage).
///
/// NOTE on "Free to Use" Stock Design:
/// "Free to Use" = stock_balances.quantity minus the sum of document_lines.expected_qty
/// for all outgoing documents (DELIVERY, or TRANSFER where source is this location) currently in
/// 'READY' or 'WAITING' status. This is computed dynamically via a query in Prompts 5/6,
/// NOT stored as a reserved_qty column.
model StockBalance {
  productId  String   @map("product_id")
  locationId String   @map("location_id")
  quantity   Int      @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at")

  product  Product  @relation(fields: [productId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@id([productId, locationId])
  @@map("stock_balances")
}

